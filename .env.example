# NutriPlanner environment settings
#
# Copy this file to .env.local (git ignores it) and fill in the values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup.
#
# Leave the Firebase values empty to run in demo mode with sample data.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to force demo mode even when Firebase values are filled in.
EXPO_PUBLIC_DEMO_MODE=

# Optional: point the app at local Firebase emulators (npm run emulators).
# Use localhost for the browser, or your PC's network address (for example
# 192.168.1.20) when testing on your phone.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
