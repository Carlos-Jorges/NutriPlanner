{
  "name": "nutriplanner",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/permanent-marker": "^0.4.0",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "firebase": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "firebase-tools": "^15.37.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "web": "expo start --web",
    "demo": "cross-env EXPO_PUBLIC_DEMO_MODE=1 expo start",
    "typecheck": "tsc --noEmit",
    "test": "cross-env TZ=Australia/Sydney jest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nutriplanner \"jest --config rules-tests/jest.config.js --runInBand\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-nutriplanner",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "lint": "eslint .",
    "deploy:web": "expo export --platform web && firebase deploy --only hosting",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/rules-tests/"
    ]
  }
}
